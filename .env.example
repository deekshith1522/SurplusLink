# Required in production. Long random string. Never commit the real value.
SURPLUSLINK_SECRET_KEY=change-me-long-random-string
# Set to "production" on the server so a missing secret key fails fast.
SURPLUSLINK_ENV=development
# Path to the SQLite database file. Defaults to instance/surpluslink.db in the project folder.
SURPLUSLINK_DB_PATH=instance/surpluslink.db
